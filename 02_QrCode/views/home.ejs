<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QR Code Generator</title>
    <style>
        :root {
            --primary: #6366f1;
            --bg: #f8fafc;
            --card: #ffffff;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }
        .container {
            background: var(--card);
            padding: 2rem;
            border-radius: 1rem;
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
            width: 100%;
            max-width: 400px;
            text-align: center;
        }
        h1 { color: #1e293b; margin-bottom: 1.5rem; font-size: 1.5rem; }
        .form { display: flex; flex-direction: column; gap: 1rem; text-align: left; }
        label { font-size: 0.875rem; font-weight: 600; color: #64748b; }
        input[type="text"], input[type="number"] {
            padding: 0.75rem;
            border: 1px solid #e2e8f0;
            border-radius: 0.5rem;
            outline: none;
        }
        input[type="color"] {
            border: none; width: 100%; height: 40px; cursor: pointer; background: none;
        }
        button {
            background: var(--primary);
            color: white;
            border: none;
            padding: 0.75rem;
            border-radius: 0.5rem;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.2s;
        }
        button:hover { opacity: 0.9; }
        .qr { margin-top: 2rem; padding-top: 2rem; border-top: 1px solid #f1f5f9; }
        .qr img { max-width: 100%; height: auto; border-radius: 0.5rem; }
        .error { color: #ef4444; background: #fee2e2; padding: 0.5rem; border-radius: 0.4rem; margin-bottom: 1rem; }
        .download-btn { background: #10b981; margin-top: 1rem; width: 100%; }
        a { text-decoration: none; }
    </style>
</head>
<body>
    <div class="container">
        <h1>QR Code Generator</h1>

        <% if (locals.error) { %>
            <div class="error"><%= error %></div>
        <% } %>

        <form class="form" action="/generate" method="POST">
            <label>Enter your text or URL</label>
            <input type="text" name="url" placeholder="url or text" required>
            
            <label>Choose Color</label>
            <input type="color" name="color" value="#000000" required>

            <label>Size (px)</label>
            <input type="number" name="size" value="200" required>

            <button type="submit">Generate QR Code</button>
        </form>

        <% if (locals.qrCode) { %>
            <div class="qr">
                <h2>Your QR Code</h2>
                <img src="<%= qrCode %>" alt="qrcode">
                <p>Scan & Go: <a href="<%= url %>" target="_blank" style="color: var(--primary); word-break: break-all;"><%= url %></a></p>
                <a href="<%= qrCode %>" download="qrcode.png">
                    <button type="button" class="download-btn">Download Image</button>
                </a>
            </div>
        <% } %>
    </div>
</body>
</html>