<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include("./partials/head") %>
    <title>Blogify - Home</title>
</head>
<body class="d-flex flex-column min-vh-100">
    <%- include("./partials/nav") %>

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="container">
            <h1>Build Your Voice Online</h1>
            <p>Create, publish, and explore blogs in a modern platform built for thinkers, creators, and storytellers.</p>
            <div class="hero-cta-group">
                <div class="hero-actions">
                    <a href="/blog/add-blog" class="btn btn-primary">Start Blogging</a>
                </div>
                <p class="hero-secondary">Start your journey today—no barriers.</p>
            </div>
        </div>
    </section>

    <main class="flex-grow-1">
        <div class="container mt-5">
            <h2 class="text-center mb-4">Latest Blogs</h2>
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                <% blogs.forEach(blog => { %>
                    <div class="col">
                        <div class="card h-100">
                            <img src="<%= blog.coverImage %>" class="card-img-top" alt="<%= blog.title %>">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title"><%= blog.title %></h5>
                                <p class="card-text">
                                    <small class="text-muted">
                                        <% if (blog.createdBy && blog.createdBy.fullName) { %>
                                            By <%= blog.createdBy.fullName %> •
                                        <% } %>
                                        <%= new Date(blog.createdAt).toLocaleDateString() %>
                                    </small>
                                </p>
                                <p class="card-text flex-grow-1">
                                    <%= blog.body.substring(0, 100) %>...
                                </p>
                                <a href="/blog/<%= blog._id %>" class="btn btn-primary mt-auto">Read More</a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </main>

    <%- include("./partials/script") %>
    <%- include('partials/footer') %>
</body>
</html>