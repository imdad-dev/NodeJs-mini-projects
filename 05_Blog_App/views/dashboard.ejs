
<!DOCTYPE html>
<html lang="en">
<head>
<%- include('./partials/head') %>
    <title>Dashboard</title>
</head>

<body class="d-flex flex-column min-vh-100">

   <%- include('./partials/nav') %> 

  <main class="flex-grow-1">
    <div class="container mt-5">
        <div class="dashboard-section">
            <div class="dashboard-header">
                <h2 class="mb-0">Your Dashboard</h2>
                <p class="text-secondary mt-2 mb-0">Manage your published blogs and account settings</p>
            </div>

            <div class="dashboard-stats">
                <div class="stat-card">
                    <h3><%= blogs.length %></h3>
                    <p>Published Blogs</p>
                </div>
                <div class="stat-card">
                    <h3><%= blogs.reduce((total, blog) => total + (blog.views || 0), 0) %></h3>
                    <p>Total Views</p>
                </div>
                <div class="stat-card">
                    <h3><%= blogs.filter(blog => new Date(blog.createdAt) > new Date(Date.now() - 30*24*60*60*1000)).length %></h3>
                    <p>Blogs This Month</p>
                </div>
            </div>
        </div>

        <div class="dashboard-section">
            <h3 class="mb-4">Your Published Blogs</h3>
            <% if (blogs.length === 0) { %>
                <div class="text-center py-5">
                    <i class="bi bi-journal-x text-secondary" style="font-size: 3rem;"></i>
                    <h5 class="mt-3 text-secondary">No blogs published yet</h5>
                    <p class="text-muted">Start sharing your thoughts with the world!</p>
                    <a href="/blog/add-blog" class="btn btn-primary">Create Your First Blog</a>
                </div>
            <% } else { %>
                <div class="row">
                    <% blogs.forEach(blog => { %>
                        <div class="col-lg-6 mb-4">
                            <div class="card h-100">
                                <% if (blog.coverImage) { %>
                                    <img src="<%= blog.coverImage %>" class="card-img-top" alt="<%= blog.title %>">
                                <% } %>
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title"><%= blog.title %></h5>
                                    <p class="card-text flex-grow-1">
                                        <%= blog.body.substring(0, 120) %>...
                                    </p>
                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        <small class="text-muted">
                                            <%= new Date(blog.createdAt).toLocaleDateString() %>
                                        </small>
                                        <div>
                                            <a href="/blog/<%= blog._id %>" class="btn btn-outline-primary btn-sm me-2">View</a>
                                            <a href="/blog/edit/<%= blog._id %>" class="btn btn-outline-secondary btn-sm me-2">Edit</a>
                                            <form action="/blog/delete/<%= blog._id %>?_method=DELETE" method="POST" style="display:inline;">
                                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                                    onclick="return confirm('Are you sure you want to delete this blog?');">
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </div>
  </main>
 
 <%- include('./partials/script') %>
 <%- include('partials/footer') %>
</body>
</html>