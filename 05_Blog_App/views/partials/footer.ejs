<footer class="blogify-footer">
  <div class="container footer-top">
    <div class="row gy-4 align-items-start">

      <div class="col-lg-5 footer-brand">
        <h6 class="footer-logo">Blogify</h6>
        <p class="footer-tagline">Create blogs worth sharing</p>
        <p class="footer-description">A polished space for authors, makers and tech storytellers to publish ideas with confidence.</p>
      </div>

      <div class="col-lg-4 footer-links">
        <h6>Quick Link</h6>
        <ul>
          <li><a href="/">Home</a></li>
          <% if (locals.user) { %>
            <li><a href="/blog/add-blog">Add Blog</a></li>
            <li><a href="/user/dashboard">Dashboard</a></li>
          <% } else { %>
            <li><a href="/user/login">Sign in</a></li>
          <% } %>
        </ul>
      </div>

      <div class="col-lg-3 footer-social">
        <h6>Connect</h6>
        <a href="https://github.com/imdad-dev" class="footer-social-link" target="_blank" rel="noreferrer">
          <i class="bi bi-github"></i>
          GitHub
        </a>
      </div>

    </div>

    <hr class="footer-divider my-3">

    <div class="footer-bottom">
      <div>© 2026 Blogify. All rights reserved</div>
      <div>Designed by <span class="footer-credit">Imdad</span></div>
    </div>
  </div>
</footer>