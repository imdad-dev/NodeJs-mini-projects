 <footer class="bg-dark text-light border-top border-secondary mt-auto pt-3 pb-2">
  <div class="container">

    <div class="row gy-2">

      <!-- Brand -->
      <div class="col-md-4">
        <h6 class="fw-bold mb-1">
          <span class="text-primary">B</span>logify
        </h6>
        <p class="small text-secondary mb-0">
          Share your ideas with the world 🚀
        </p>
      </div>

      <!-- Links -->
      <div class="col-md-4">
        <h6 class="fw-semibold mb-1 small">Links</h6>
        <ul class="list-unstyled small mb-0">
          <li>
            <a href="/" class="text-secondary text-decoration-none">Home</a>
          </li>

          <% if (locals.user) { %>
            <li>
              <a href="/blog/add-blog" class="text-secondary text-decoration-none">Add Blog</a>
                    
                    <li><a class="text-secondary text-decoration-none" href="/user/dashboard">Dashboard</a></li>
            </li>
          <% } else { %>
            <li>
              <a href="/user/login" class="text-secondary text-decoration-none">Signin</a>
            </li>
          <% } %>
        </ul>
      </div>

      <!-- Contact -->
      <div class="col-md-4">
        <h6 class="fw-semibold mb-1 small">Contact</h6>
        <p class="small text-secondary mb-1">
          support@blogify.com
        </p>
      </div>

    </div>

    <hr class="border-secondary my-2">

    <!-- Bottom -->
    <div class="text-center small text-secondary">
      &copy; <%= new Date().getFullYear() %> Blogify
    </div>

  </div>
</footer>