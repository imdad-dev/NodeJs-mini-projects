<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title><%= blog.title %> | BlogView</title>
    <style>
        /* Modern Typography & Spacing */
        .blog-container { max-width: 800px; margin-top: 50px; }
        .blog-header { margin-bottom: 2rem; }
        .blog-title { font-weight: 800; letter-spacing: -1px; line-height: 1.2; }
        .blog-meta { color: #6c757d; font-size: 0.95rem; }
        .blog-cover-img { 
            width: 100%; 
            max-height: 450px; 
            object-fit: cover; 
            border-radius: 16px; 
            margin-bottom: 2.5rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }
        /* Style for the body content */
        .blog-body { 
            font-size: 1.15rem; 
            line-height: 1.8; 
            color: #212529; 
        }
        .blog-body p { margin-bottom: 1.5rem; }
        /* Style for code blocks if user sends <code> or <pre> */
        pre {
            background: #2d2d2d;
            color: #f8f8f2;
            padding: 1.5rem;
            border-radius: 8px;
            overflow-x: auto;
        }
    </style>
</head>
<body class="bg-light">
    <%- include('./partials/nav') %> 

    <main class="container blog-container bg-white p-4 p-md-5 shadow-sm rounded">
        
        <header class="blog-header text-center">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb justify-content-center">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item active">Article</li>
                </ol>
            </nav>
            <h1 class="blog-title display-4 mt-2"><%= blog.title %></h1>
         <div class="blog-meta mt-3">
    <span class="me-3"><i class="bi bi-person"></i> By Author : <%= blog.createdBy.fullName %></span>
    
    <span class="me-3">
        <i class="bi bi-calendar3"></i> 
        <%= new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
    </span>

    <span>
        <i class="bi bi-clock"></i> 
        <%= Math.floor(Math.random() * (12 - 5 + 1)) + 5 %> min read
    </span>
</div>
        </header>

        <% if (blog.coverImage) { %>
            <img src="<%= blog.coverImage %>" class="blog-cover-img" alt="<%= blog.title %>">
        <% } %>

        <article class="blog-body">
        <%- blog.body %> 
        </article>

        <hr class="my-5">

        <div class="d-flex justify-content-between align-items-center">
            <button class="btn btn-outline-primary btn-sm rounded-pill px-3">
                <i class="bi bi-hand-thumbs-up"></i> Like
            </button>
            <div>
                <a href="#" class="text-secondary me-3"><i class="bi bi-twitter-x"></i></a>
                <a href="#" class="text-secondary"><i class="bi bi-link-45deg"></i></a>
            </div>
        </div>

  <!-- comment handle  -->

      <h4 class="mb-4 fw-bold">Comments <%=(comments.length)%></h4>
  <% if(locals.user) { %>
   
<hr class="my-5">

<section class="comment-section">

    <div class="card border-0 bg-light rounded-4 mb-5">
        <div class="card-body p-4">
            <h6 class="card-title fw-bold mb-3">Leave a Reply</h6>
            <form action="/blog/comment/<%= blog._id %>" method="POST">
                <div class="mb-3">
                    <textarea 
                        name="content" 
                        class="form-control border-0 shadow-sm" 
                        rows="3" 
                        placeholder="Join the discussion..." 
                        required
                    ></textarea>
                </div>
                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Post Comment</button>
                </div>
            </form>
        </div>
    </div>

</section>
 
  <% } %>

  
 <div class="comments-list">
        <% if (comments && comments.length > 0) { %>
            <% comments.forEach(comment => { %>
                <div class="d-flex mb-4">
                    <div class="flex-shrink-0">
                        <img src="<%=comment.createdBy.profileImageURL %>" class="rounded-circle" width="45" height="45">
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <div class="bg-white p-3 rounded-4 shadow-sm border">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold small"><%= comment.createdBy.fullName %></span>
                                <small class="text-muted">Just now</small>
                            </div>
                            <p class="mb-0 text-secondary small">
                                <%= comment.content %>
                            </p>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <p class="text-center text-muted small">No comments yet. Be the first to share your thoughts!</p>
        <% } %>
    </div>


    </main>

    <%- include('./partials/script') %>
    <%- include('partials/footer') %>
</body>
</html>